# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/api/admin/calendar/callback

# Postgres (Neon / Vercel Postgres / Supabase). If unset, an in-memory demo store is used.
DATABASE_URL=
# Optional Redis (Upstash) for shared rate limiting / locks
REDIS_URL=

# Email (Resend). If unset, emails are logged only.
EMAIL_API_KEY=
EMAIL_FROM="Md Hasan Mahfuz <bookings@example.com>"

# 32+ random chars: signs admin sessions
NEXTAUTH_SECRET=
# 64 hex chars (32 bytes): encrypts Google refresh tokens at rest
TOKEN_ENCRYPTION_KEY=
# Admin login (the Google account email allowed to sign in as admin)
ADMIN_EMAIL=
# bcrypt-free: scrypt hash from `node scripts/hash-password.mjs <password>`
ADMIN_PASSWORD_HASH=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
